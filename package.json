{
  "name": "magpie-bilingual-bridge",
  "version": "0.2.0",
  "private": true,
  "description": "MAGPIE bilingual provider for Claude Code and native models including Codex",
  "type": "module",
  "main": "./index.mjs",
  "files": ["index.mjs", "src", "page", "README.md", "config.example.json", "PRD.md", "docs", "scripts", "test"],
  "scripts": {
    "build": "node scripts/build-page.mjs",
    "prepack": "npm run build",
    "test": "node --test test/*.test.mjs",
    "probe": "node scripts/probe.mjs",
    "test:host": "node scripts/test-host.mjs",
    "test:live": "node scripts/test-live.mjs"
  },
  "engines": { "node": ">=22" },
  "magpie": {
    "name": "双语桥接",
    "maxConcurrency": 4,
    "page": {
      "title": "双语桥接",
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "titles": { "zh": "双语桥接" }
    },
    "permissions": ["providers:list"]
  }
}
